# Collected data. Everything here is re-fetchable: src/collect.py resumes from
# whatever is already on disk, and src/validate_xg.py caches StatsBomb itself.
data/raw/
data/statsbomb/
data/proc/
data/fixtures.json

# Environment
venv/
vendor/
__pycache__/
*.pyc
.DS_Store

# Large artefacts that are regenerated by a run
reports/*.npz

# The trained model is regenerated by src/train_final.py; the metadata
# beside it (data window, metrics, git SHA) is what is worth keeping.
models/*.joblib
!models/xg.json
data/qdrant/

# Latency samples are committed by the workflow, not ignored
!reports/latency.jsonl

